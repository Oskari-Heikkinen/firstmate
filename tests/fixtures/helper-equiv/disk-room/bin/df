#!/bin/sh
# Fake df for fm-helper-equiv fixtures: the value of --output=FIELD for PATH is
# the file $FAKE_DF/<basename of PATH>.FIELD.
field='' path=''
for a in "$@"; do case "$a" in --output=*) field=${a#--output=} ;; -*) ;; *) path=$a ;; esac; done
f="$FAKE_DF/${path##*/}.$field"
[ -r "$f" ] || { echo "df: $path: No such file or directory" >&2; exit 1; }
printf '%s\n' "$field"; cat "$f"
