          "writes": {
            "min": 0,
            "max": 0
          },
          "input": {
            "path": "/example/tetjet-sync/xp/offered",
            "reach": {
              "kind": "synced",
              "source": "tetjet:/srv/example/xp/offered",
              "max_lag": "15m"
            },
            "match": "*.json",
            "type_field": "schema_version"
          },
          "outbox": {
            "path": "/example/tetjet-sync/receipts/offer-intake",
            "reach": {
              "kind": "synced",
