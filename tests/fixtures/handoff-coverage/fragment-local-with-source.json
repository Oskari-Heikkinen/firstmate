          "cleanup": {
            "action": "keep"
          },
          "actors": [
            "process:lattice-xp-file"
          ]
        },
        {
          "name": "compile",
          "owner": "lattice-research-mate",
          "accepts": {
            "min": 0,
            "max": 0
          },
          "writes": {
            "min": 0,
            "max": 0
          },
          "input": {
            "path": "/example/research/xp/compile",
            "reach": {
