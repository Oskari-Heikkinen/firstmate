{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic-only proc guard probes; never accepted by live capture",
  "type": "object", "additionalProperties": false,
  "required": ["format", "synthetic", "deadline_ms", "pause_ms", "scan_deadline_ms", "clock_ms", "task_limit", "pids"],
  "properties": {
    "format": {"const": "fm-supervision-proc-bounds-fixture.v1"},
    "synthetic": {"type": "boolean", "const": true},
    "deadline_ms": {"type": "integer", "minimum": 10, "maximum": 1000},
    "pause_ms": {"type": "integer", "minimum": 0, "maximum": 200},
    "scan_deadline_ms": {"type": "integer", "minimum": 1, "maximum": 1000},
    "clock_ms": {"type": "integer", "minimum": 0, "maximum": 1000},
    "task_limit": {"type": "integer", "minimum": 1, "maximum": 16},
    "pids": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "integer", "minimum": 1, "maximum": 4194304}}
  }
}
