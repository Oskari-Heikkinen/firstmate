{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-published P0 fleet enrollment, not mode-selection authority",
  "type": "object", "additionalProperties": false,
  "required": ["format", "certified_complete", "publisher", "enrolled_homes", "homes"],
  "properties": {
    "format": {"const": "fm-supervision-fleet-manifest.v1"},
    "certified_complete": {"type": "boolean"},
    "publisher": {"$ref": "#/$defs/text"},
    "enrolled_homes": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "homes": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/home"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]{0,63}"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "path": {"type": "string", "pattern": "/[^\\u0000\\n\\r]+", "maxLength": 4096},
    "sha": {"type": "string", "pattern": "[0-9a-f]{40}"},
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["device", "inode"],
      "properties": {"device": {"type": "integer", "minimum": 0}, "inode": {"type": "integer", "minimum": 1}}
    },
    "root": {
      "type": "object", "additionalProperties": false, "required": ["pid", "start_ticks"],
      "properties": {"pid": {"type": "integer", "minimum": 1, "maximum": 4194304}, "start_ticks": {"type": "string", "pattern": "[0-9]{1,24}"}}
    },
    "timer": {
      "type": "object", "additionalProperties": false, "required": ["name", "interval_ms", "bound_ms"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "interval_ms": {"type": "integer", "minimum": 1}, "bound_ms": {"type": "integer", "minimum": 1}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "registration_token", "result_sequence", "claim_identity", "executor_version"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "registration_token": {"$ref": "#/$defs/text"}, "result_sequence": {"type": "integer", "minimum": 0}, "claim_identity": {"$ref": "#/$defs/text"}, "executor_version": {"$ref": "#/$defs/text"}}
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "spawn_generation", "kind", "endpoint_identity", "park_token", "custody_phase"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "spawn_generation": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/text"}, "endpoint_identity": {"$ref": "#/$defs/text"}, "park_token": {"type": "string", "maxLength": 4096}, "custody_phase": {"$ref": "#/$defs/text"}}
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "binding", "interval_ms"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "binding": {"$ref": "#/$defs/text"}, "interval_ms": {"type": "integer", "minimum": 1}}
    },
    "home": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "owner", "published_at", "home", "state_root", "state_identity", "machine", "remote", "code_root", "code_ref", "primary_harness", "backend", "session_identity", "parent_route", "configuration_sha256", "timers", "tasks", "sources", "checks", "unsupported_integrations", "capture_roots"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "owner": {"$ref": "#/$defs/text"},
        "published_at": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"},
        "home": {"$ref": "#/$defs/path"}, "state_root": {"$ref": "#/$defs/path"}, "state_identity": {"$ref": "#/$defs/identity"},
        "machine": {"$ref": "#/$defs/text"}, "remote": {"type": "boolean"},
        "code_root": {"$ref": "#/$defs/path"}, "code_ref": {"$ref": "#/$defs/sha"},
        "primary_harness": {"$ref": "#/$defs/text"}, "backend": {"$ref": "#/$defs/text"},
        "session_identity": {"$ref": "#/$defs/text"}, "parent_route": {"$ref": "#/$defs/text"},
        "configuration_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "timers": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/timer"}},
        "tasks": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/task"}},
        "sources": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/source"}},
        "checks": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/check"}},
        "unsupported_integrations": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "capture_roots": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/root"}}
      }
    }
  }
}
