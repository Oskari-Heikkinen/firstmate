{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sealed CI per-tick calibration payload (canonical JSON SHA-256 envelope)",
  "type": "object", "additionalProperties": false,
  "required": ["format", "revision", "runner", "ci_url", "method", "plan", "results", "uncertainty"],
  "properties": {
    "format": {"const": "fm-supervision-calibration.v1"},
    "revision": {"type": "string", "pattern": "[0-9a-f]{40}"},
    "runner": {"type": "string", "minLength": 1, "maxLength": 256},
    "ci_url": {"type": "string", "pattern": "https://github.com/[^/]+/[^/]+/actions/runs/[0-9]+"},
    "method": {"const": "launch-strace-process+GNU-time-subtree.v1"},
    "plan": {"type": "object"},
    "results": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/result"}},
    "uncertainty": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000000000000000},
    "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/count"}},
    "tick-record": {
      "type": "object", "additionalProperties": false, "required": ["name", "base64", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "base64": {"type": "string", "maxLength": 8388608},
        "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["births", "user_ns", "system_ns", "cpu_reading", "trace_base64", "trace_sha256", "ticks", "tick_records"],
      "properties": {
        "ticks": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "tick_records": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/tick-record"}},
        "births": {"$ref": "#/$defs/count"}, "user_ns": {"$ref": "#/$defs/count"}, "system_ns": {"$ref": "#/$defs/count"},
        "cpu_reading": {"type": "string", "pattern": "[0-9]+\\.[0-9]{2} [0-9]+\\.[0-9]{2}"},
        "trace_base64": {"type": "string", "maxLength": 1398104},
        "trace_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "unavailable": {"type": "string", "minLength": 1, "maxLength": 4096},
        "samples": {"type": "array", "minItems": 3, "maxItems": 9, "items": {"$ref": "#/$defs/sample"}},
        "uncertainty": {
          "type": "object", "additionalProperties": false,
          "required": ["cpu_quantization_ns_per_component", "repeat_ranges"],
          "properties": {
            "cpu_quantization_ns_per_component": {"const": 10000000},
            "repeat_ranges": {
              "type": "object", "additionalProperties": false, "required": ["births", "user_ns", "system_ns"],
              "properties": {
                "births": {"$ref": "#/$defs/range"}, "user_ns": {"$ref": "#/$defs/range"}, "system_ns": {"$ref": "#/$defs/range"}
              }
            }
          }
        }
      }
    }
  }
}
