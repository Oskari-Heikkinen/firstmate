{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline attribution inputs and CI calibration plan",
  "type": "object", "additionalProperties": false,
  "required": ["format", "synthetic", "allocation", "profiles"],
  "properties": {
    "format": {"enum": ["fm-supervision-calibration-plan.v1", "fm-supervision-tick-records.v1"]},
    "synthetic": {"type": "boolean"},
    "allocation": {"const": "exclusive-home-family-v1"},
    "profiles": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]{0,63}"},
    "sha": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "ns": {"type": "integer", "minimum": 0},
    "fragment": {
      "type": "object", "additionalProperties": false, "required": ["record_path", "base64", "sha256"],
      "properties": {
        "record_path": {"type": "string", "pattern": "/[^\u0000\n\r]+", "maxLength": 4096},
        "base64": {"type": "string", "maxLength": 8388608}, "sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false, "required": ["path", "base64", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/text"}, "base64": {"type": "string", "maxLength": 87384},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "env": {
      "type": "object", "additionalProperties": false, "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "[A-Z][A-Z0-9_]{0,63}"},
        "value": {"type": "string", "maxLength": 4096}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["home", "family", "code_ref", "configuration_sha256", "qualification"],
      "properties": {
        "home": {"$ref": "#/$defs/id"}, "family": {"$ref": "#/$defs/id"},
        "code_ref": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "configuration_sha256": {"$ref": "#/$defs/sha"},
        "work_mix_sha256": {"$ref": "#/$defs/sha"},
        "tick_unit": {"$ref": "#/$defs/text"},
        "qualification": {"$ref": "#/$defs/text"},
        "unavailable": {"$ref": "#/$defs/text"},
        "ticks_per_sample": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "fixture_files": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/fixture"}},
        "argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/text"}},
        "environment": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/env"}},
        "record_path": {"type": "string", "pattern": "/[^\u0000\n\r]+", "maxLength": 4096},
        "line_contains": {"type": "string", "pattern": "[^\u0000\n\r]+", "maxLength": 1024},
        "timestamp": {"enum": ["epoch-tab-seconds", "status-at-seconds", "json-wall-ns", "json-epoch-seconds", "supervision-tick-v1", "supervision-tick-v2"]},
        "record_kind": {"enum": ["owned-loop", "concurrent"]},
        "instrumentation_error": {"type": "boolean"},
        "fragments": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/fragment"}},
        "timestamp_field": {"type": "string", "pattern": "[a-zA-Z_][a-zA-Z0-9_]{0,63}"},
        "coverage_start_wall_ns": {"$ref": "#/$defs/ns"},
        "coverage_end_wall_ns": {"$ref": "#/$defs/ns"},
        "base64": {"type": "string", "maxLength": 8388608},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
