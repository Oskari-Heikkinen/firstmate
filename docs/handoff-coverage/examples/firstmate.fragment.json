            "held": "4h",
            "waiting": "1h"
          },
          "cleanup": {
            "action": "keep"
          },
          "codes": {
            "delivery-unknown": {
              "fix_owner": "tooling-mate",
              "holds_all": false,
              "what": "tooling-mate cannot tell whether the request reached docs-mate; it may resend under the same correlation"
            },
            "reply-missed": {
              "fix_owner": "docs-mate",
              "holds_all": false,
              "what": "docs-mate sent no correlated reply, even after REPOST REQUIRED"
            },
            "unacked": {
              "fix_owner": "docs-mate",
              "holds_all": false,
              "what": "docs-mate has not moved the request to handled/ through the whole inbox re-ring ladder"
            }
          },
          "ext": {
            "tooling-mate.receipt-adapter": "corr-request"
          },
          "input": {
            "match": "*.msg",
            "path": "/example/homes/tooling-mate/state/docs-mate.inbox",
            "reach": {
              "kind": "local"
            }
          },
          "name": "reply.docs-mate",
          "outbox": {
            "path": "/example/homes/tooling-mate/state/pending-replies",
            "reach": {
              "kind": "local"
            }
          },
          "owner": "tooling-mate",
          "retry_limit": 1
        }
      ],
      "title": "Marked fm-send requests from tooling-mate to its secondmates, until the correlated reply",
      "versions": {
        "max": 1,
        "min": 1
