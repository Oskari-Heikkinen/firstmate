{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff-receipt/v1",
  "title": "handoff-receipt/v1",
  "description": "One stage's outcome for one record, attempt and transition. docs/handoff-coverage.md owns the meaning of every field; bin/fm-handoff-validate.py adds the cross-field checks a schema cannot express.",
  "type": "object",
  "required": ["format", "receipt_id", "written_at", "protocol", "version", "stage", "home", "record", "attempt", "seq", "state"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "handoff-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "written_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "protocol": {"$ref": "#/$defs/name"},
    "version": {"type": "integer", "minimum": 0},
    "stage": {"$ref": "#/$defs/name"},
    "home": {"$ref": "#/$defs/home"},
    "record": {"type": "string", "pattern": "^[^\\s]{1,256}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "seq": {"type": "integer", "minimum": 1},
    "state": {"enum": ["accepted", "refused", "held", "waiting", "done"]},
    "code": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "reason": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "holds_all": {"type": "boolean"},
    "stops": {"type": "string", "minLength": 1, "maxLength": 1000},
    "sender": {"$ref": "#/$defs/home"},
    "input": {"type": "string", "minLength": 1, "maxLength": 1024},
    "detail": {"type": "string", "minLength": 1, "maxLength": 1000},
    "evidence": {"type": "string", "minLength": 1, "maxLength": 1024},
    "ext": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]{0,63}\\.[a-z0-9][a-z0-9_.-]{0,63}$"},
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["refused", "held"]}}},
      "then": {"required": ["code"], "properties": {"reason": false, "until": false}}
    },
    {
      "if": {"properties": {"state": {"const": "waiting"}}},
      "then": {"required": ["reason", "until"], "properties": {"code": false, "holds_all": false, "stops": false}}
    },
    {
      "if": {"properties": {"state": {"enum": ["accepted", "done"]}}},
      "then": {"properties": {"code": false, "reason": false, "until": false, "holds_all": false, "stops": false}}
    },
    {
      "if": {"required": ["holds_all"], "properties": {"holds_all": {"const": true}}},
      "then": {"required": ["stops"]},
      "else": {"properties": {"stops": false}}
    }
  ],
  "$defs": {
    "home": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
  }
}
