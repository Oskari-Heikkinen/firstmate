{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dated-rule-schedule/v1",
  "title": "dated-rule-schedule/v1 schedule",
  "description": "One home's schedule of the dated rules it owns, one row per date a rule was given. docs/dated-rule-schedule.md owns the meaning of every field; bin/fm-handoff-validate.py adds the cross-field checks a schema cannot express.",
  "type": "object",
  "required": ["format", "home", "publisher", "revision", "published_at", "rows"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "dated-rule-schedule/v1"},
    "home": {"$ref": "#/$defs/home"},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 200},
    "revision": {"type": "integer", "minimum": 1},
    "published_at": {"$ref": "#/$defs/utc"},
    "example": {"type": "boolean"},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "ext": {"$ref": "#/$defs/ext"}
  },
  "$defs": {
    "home": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1000},
    "ext": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]{0,63}\\.[a-z0-9][a-z0-9_.-]{0,63}$"},
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "mark": {
      "type": "object",
      "required": ["by", "at", "ref"],
      "additionalProperties": false,
      "properties": {
        "by": {"type": "string", "minLength": 1, "maxLength": 200},
        "at": {"$ref": "#/$defs/utc"},
        "ref": {"$ref": "#/$defs/text"}
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "rule", "owner", "date", "what", "state"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "rule": {"$ref": "#/$defs/name"},
        "owner": {"$ref": "#/$defs/home"},
        "date": {"$ref": "#/$defs/date"},
        "what": {"$ref": "#/$defs/text"},
        "state": {"enum": ["scheduled", "in-force", "withdrawn"]},
        "replaces": {"$ref": "#/$defs/name"},
        "review": {"$ref": "#/$defs/mark"},
        "main_decision": {"$ref": "#/$defs/mark"},
        "ext": {"$ref": "#/$defs/ext"}
      }
    }
  }
}
