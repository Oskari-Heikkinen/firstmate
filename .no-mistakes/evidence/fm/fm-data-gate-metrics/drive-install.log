--- installed service:
# Installed by bin/fm-data-gate-install.sh into ~/.config/systemd/user with
# /home/oskari/.no-mistakes/worktrees/ca1b14ddd4b9/01M3SJFHJB9C8T2AXATYWSMJDA/bin/fm-data-gate-report.sh replaced by the checkout's bin/fm-data-gate-report.sh and /opt/node24/bin
# by the directory of the node that ran the installer.
[Unit]
Description=Lattice data gate daily report (bin/fm-data-gate-report.sh)

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=15min
Environment="PATH=/opt/node24/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env bash "/home/oskari/.no-mistakes/worktrees/ca1b14ddd4b9/01M3SJFHJB9C8T2AXATYWSMJDA/bin/fm-data-gate-report.sh"
--- installed timer:
# Installed by bin/fm-data-gate-install.sh into ~/.config/systemd/user.
# 00:40 leaves the report's 30-minute DIGEST.md window past midnight complete.
[Unit]
Description=Write the lattice data gate report for the finished day

[Timer]
OnCalendar=*-*-* 00:40:00
Persistent=true

[Install]
WantedBy=timers.target

